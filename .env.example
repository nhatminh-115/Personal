# ==============================================================================
# AURA Environment Configuration
# ==============================================================================

# Application
APP_NAME="AURA — Adaptive User Runtime Agent"
DEBUG=false
LOG_LEVEL=INFO

# Database Configuration
# Local SQLite fallback:
DATABASE_URL=sqlite+aiosqlite:///aura.db
# Production / Docker Compose PostgreSQL with pgvector:
# DATABASE_URL=postgresql+asyncpg://aura:aura@localhost:5432/aura
DATABASE_ECHO=false

# Workspace Sandbox Directory
AURA_WORKSPACE_ROOT=./workspace

# Model Provider
# Options: "mock" (offline deterministic testing) or "openai" (OpenAI / Ollama / vLLM)
MODEL_PROVIDER=mock

# OpenAI / OpenAI-Compatible Provider Settings
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
# For local Ollama:
# OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL_NAME=gpt-4o-mini
MODEL_TEMPERATURE=0.0
MODEL_MAX_TOKENS=2048
