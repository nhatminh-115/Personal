# ==============================================================================
# AURA Environment Configuration
# ==============================================================================

# Application
APP_NAME="AURA — Adaptive User Runtime Agent"
DEBUG=false
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Configuration
# Local SQLite fallback:
DATABASE_URL=sqlite+aiosqlite:///aura.db
# Production / Docker Compose PostgreSQL with pgvector:
# DATABASE_URL=postgresql+asyncpg://aura:aura@localhost:5432/aura
DATABASE_ECHO=false

# Workspace Sandbox Directory
AURA_WORKSPACE_ROOT=./workspace
# Optional local sandbox image tag. Build this trusted image locally; AURA does not pull it automatically.
# AURA_SANDBOX_IMAGE=aura-coding-sandbox:latest

# Model Provider
# Options: "mock" (offline deterministic testing) or "openai" (OpenAI / Ollama / vLLM)
MODEL_PROVIDER=mock

# OpenAI / OpenAI-Compatible Provider Settings
# Leave empty until a real key is configured; a non-empty value marks OpenAI available.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-4o-mini
# Local provider discovery. When using Docker Compose with a model server on the
# host, use host.docker.internal instead of 127.0.0.1 in these URLs.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
MODEL_TEMPERATURE=0.0
MODEL_MAX_TOKENS=2048

# Research Provider Settings
# Options: "deterministic" (offline fixture corpus) or "live" (Semantic Scholar + arXiv)
RESEARCH_PROVIDER_MODE=deterministic
# Optional Semantic Scholar API Key (higher rate limits)
SEMANTIC_SCHOLAR_API_KEY=
RESEARCH_HTTP_TIMEOUT_SECONDS=30.0
RESEARCH_MAX_PDF_BYTES=15728640
RESEARCH_MAX_PDF_PAGES=50
RESEARCH_MAX_EXTRACTED_CHARS=500000
ARXIV_MIN_REQUEST_INTERVAL_SECONDS=3.0
