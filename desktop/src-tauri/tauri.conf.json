{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AURA",
  "version": "0.2.0",
  "identifier": "com.aura.personal.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../web run desktop:dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix ../web run desktop:build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kuractus",
        "width": 1440,
        "height": 920,
        "minWidth": 980,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:17890; frame-src 'self' blob:; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "category": "Productivity",
    "shortDescription": "Kuractus Personal workspace",
    "longDescription": "A durable personal AI workspace that runs on your Windows PC.",
    "resources": {
      "binaries/aura-api.exe": "aura-api.exe",
      "../runtime/compose.yaml": "runtime/compose.yaml"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
